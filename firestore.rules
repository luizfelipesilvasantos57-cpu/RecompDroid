rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model:
    // users/{uid}: private profile; only the owner can read or write.
    // users/{uid}/games/{slug}: private playtime totals; only the owner can access.
    // users/{uid}/reviews/{gameHash}: private ownership mapping and editable review.
    // games/{gameHash}/reviews/{randomReviewId}: public rating/comment only, with
    //   no email, username, or UID.

    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'username', 'photoBase64', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'username', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.username is string
        && data.username.matches('^[A-Za-z0-9_.]{3,24}$')
        && data.updatedAt is timestamp
        && (!('photoBase64' in data)
          || (data.photoBase64 is string && data.photoBase64.size() <= 700000));
    }

    function validGameProgress(data) {
      return data.keys().hasOnly(['title', 'playSeconds', 'launches', 'lastPlayedAt'])
        && data.keys().hasAll(['title', 'playSeconds', 'launches', 'lastPlayedAt'])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.playSeconds is int
        && data.playSeconds >= 0
        && data.playSeconds <= 315360000
        && data.launches is int
        && data.launches >= 0
        && data.launches <= 1000000
        && data.lastPlayedAt is timestamp;
    }

    function validPrivateReview(data, gameHash) {
      return gameHash.matches('^[a-f0-9]{64}$')
        && data.keys().hasOnly(['reviewId', 'rating', 'comment', 'updatedAt'])
        && data.keys().hasAll(['reviewId', 'rating', 'comment', 'updatedAt'])
        && data.reviewId is string
        && data.reviewId.matches('^[A-Za-z0-9]{20}$')
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() <= 500
        && data.updatedAt is timestamp;
    }

    function validPublicReview(data) {
      return data.keys().hasOnly(['rating', 'comment', 'updatedAt'])
        && data.keys().hasAll(['rating', 'comment', 'updatedAt'])
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() <= 500
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get, list: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validProfile(request.resource.data);
      allow delete: if false;

      match /games/{gameId} {
        allow get, list: if signedInAs(userId);
        allow create, update: if signedInAs(userId) && validGameProgress(request.resource.data);
        allow delete: if false;
      }

      match /reviews/{gameHash} {
        allow get, list: if signedInAs(userId);
        allow create, update: if signedInAs(userId) && validPrivateReview(request.resource.data, gameHash);
        allow delete: if false;
      }
    }

    match /games/{gameHash}/reviews/{reviewId} {
      // The user explicitly requested that guests can read notes and reviews.
      allow get, list: if true;
      allow create, update: if request.auth != null
        && validPublicReview(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
